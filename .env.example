# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Environment ---
ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO
SENTRY_DSN=                      # optional

# --- HTTP ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---
# SQLite default for local dev:
DATABASE_URL=sqlite+aiosqlite:///./app/data/hermes.db
# Postgres (production / Docker):
# DATABASE_URL=postgresql+asyncpg://hermes:hermes@localhost:5432/hermes
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Cache ---
# Empty = in-memory cache. Set to redis://... to enable Redis.
REDIS_URL=
CACHE_TTL_SECONDS=60
CACHE_DEFAULT_SIZE=4096

# --- Auth ---
# IMPORTANT: generate a strong secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# --- Market data providers ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINMARKETCAP_API_KEY=
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=
ETHERSCAN_API_KEY=
GLASSNODE_API_KEY=
INTOTHEBLOCK_API_KEY=
ARKHAM_API_KEY=
WHALE_ALERT_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# --- Prediction engine ---
PREDICTION_HORIZON_BARS=1
PREDICTION_WINDOW=256
FEATURE_WINDOW=128
ENSEMBLE_MIN_SAMPLES=60
MONTE_CARLO_SIMS=10000
MONTE_CARLO_HORIZON=24
VAR_CONFIDENCE=0.95

# --- Market defaults ---
DEFAULT_ASSETS=["BTC","ETH","SOL","BNB","XRP","ADA","DOGE","AVAX"]
DEFAULT_INTERVAL=15m
DEFAULT_QUOTE=USDT

# --- Risk engine ---
RISK_FREE_RATE=0.02
KELLY_FRACTION=0.25
MAX_POSITION_SIZE=0.20
